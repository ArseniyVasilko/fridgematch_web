# PostgreSQL. Locally: the connection string of your Neon "dev" branch (see README).
# On Vercel, the Neon integration sets DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (unpooled) connection used by `npm run db:push`; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=""

# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Optional: TheMealDB premium key (defaults to the free test key "1")
MEALDB_API_KEY=""
